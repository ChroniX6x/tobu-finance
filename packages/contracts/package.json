{
  "name": "@tobu/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsc -p tests/tsconfig.json && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "luxon": "3.7.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/luxon": "3.7.1",
    "typescript": "5.9.3"
  }
}
