{
  "name": "tobu-finance",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.8.0",
  "engines": {
    "node": "24.13.1",
    "npm": "11.8.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run start --workspace=@tobu/web",
    "dev:api": "npm run dev --workspace=@tobu/api",
    "dev:api:debug": "npm run dev:debug --workspace=@tobu/api",
    "init:api": "node scripts/workspace.mjs init",
    "start:api": "npm run start --workspace=@tobu/api",
    "build": "npm run build:api && npm run build:web",
    "build:api": "npm run build --workspace=@tobu/api",
    "build:web": "npm run build --workspace=@tobu/web",
    "typecheck": "npm run build:contracts && npm run typecheck --workspace=@tobu/api && npm run typecheck --workspace=@tobu/web",
    "test": "npm run test:api && npm run test:web",
    "test:api": "npm run test --workspace=@tobu/api",
    "test:web": "node scripts/test-web.mjs",
    "test:integration": "npm run build:api && node scripts/test-stack.mjs integration",
    "e2e": "npm run e2e --workspace=@tobu/web",
    "e2e:real": "npm run build:api && node scripts/test-stack.mjs browser",
    "check:workspace": "node scripts/check-workspace.mjs",
    "setup": "node scripts/workspace.mjs setup",
    "dev": "node scripts/workspace.mjs dev",
    "dev:debug": "node scripts/workspace.mjs debug",
    "dev:down": "node scripts/workspace.mjs down",
    "db:init": "node scripts/workspace.mjs init-db",
    "db:replica:init": "node scripts/initialize-replica-set.mjs",
    "db:seed": "node scripts/workspace.mjs seed",
    "db:migrate": "node scripts/migrations.mjs up",
    "db:migrate:status": "node scripts/migrations.mjs status",
    "db:migrate:plan": "node scripts/migrations.mjs plan",
    "db:migrate:down": "node scripts/migrations.mjs down",
    "db:migrate:recover": "node scripts/migrations.mjs recover",
    "db:migration:create": "node apps/api/scripts/migration-files.mjs create",
    "db:migration:manifest": "node apps/api/scripts/migration-files.mjs",
    "db:reset": "node scripts/workspace.mjs reset",
    "test:tooling": "node --test scripts/tests/*.test.mjs",
    "test:replica": "npm run build:api && node --test scripts/tests-docker/*.test.mjs",
    "verify:phase3": "node scripts/verify-phase3.mjs",
    "build:contracts": "npm run build --workspace=@tobu/contracts",
    "test:contracts": "npm run build:contracts && npm run test --workspace=@tobu/contracts",
    "contracts:generate": "npm run build:contracts && node scripts/generate-openapi.mjs",
    "check:contracts": "npm run build:contracts && node scripts/generate-openapi.mjs --check && node scripts/check-contracts.mjs",
    "verify:phase4": "node scripts/verify-phase4.mjs",
    "lint": "node scripts/check-source.mjs lint && node scripts/check-style.mjs lint",
    "format:check": "node scripts/check-style.mjs format",
    "quality": "node scripts/quality.mjs",
    "quality:full": "node scripts/quality.mjs --full",
    "verify:phase5": "npm run quality:full",
    "package:artifact": "node scripts/package-artifact.mjs",
    "test:artifact": "node scripts/test-artifact.mjs",
    "test:lifecycle": "node scripts/verify-phase3.mjs --runtime-only"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "eslint": "9.39.1",
    "prettier": "3.6.2",
    "typescript-eslint": "8.72.0"
  }
}
