# Root configuration for local development. No automatic native MongoDB fallback.
DB_MODE=docker
DB_PORT=27018
DEV_DB_NAME=tobu_finance_dev
COMPOSE_PROJECT=tobu-finance-dev
API_PORT=4000
WEB_PORT=4200
# Used ONLY with DB_MODE=external. Include an explicit database name.
MONGODB_URI=
# Optional fixed YYYY-MM for the first development seed.
SEED_MONTH=
