{
  "name": "@tobu/web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "e2e": "playwright test --project=chromium",
    "e2e:real": "playwright test --project=chromium-real-api",
    "e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json && tsc --noEmit -p tsconfig.e2e.json",
    "test:unit": "ng test --watch=false --browsers=ChromeHeadless"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "21.2.0",
    "@angular/cdk": "21.2.0",
    "@angular/common": "21.2.0",
    "@angular/compiler": "21.2.0",
    "@angular/core": "21.2.0",
    "@angular/forms": "21.2.0",
    "@angular/platform-browser": "21.2.0",
    "@angular/platform-browser-dynamic": "21.2.0",
    "@angular/router": "21.2.0",
    "@ngxs/devtools-plugin": "21.0.0",
    "@ngxs/logger-plugin": "21.0.0",
    "@ngxs/router-plugin": "21.0.0",
    "@ngxs/store": "21.0.0",
    "@primeuix/themes": "2.0.3",
    "@tailwindcss/postcss": "4.1.11",
    "@types/luxon": "3.6.2",
    "chart.js": "4.4.2",
    "immer": "10.1.1",
    "lodash": "4.17.21",
    "luxon": "3.7.1",
    "mongodb": "6.17.0",
    "postcss": "8.5.6",
    "primeclt": "0.1.5",
    "primeicons": "7.0.0",
    "primeng": "21.1.1",
    "quill": "2.0.3",
    "rxjs": "7.8.2",
    "tailwindcss-primeui": "0.6.1",
    "tslib": "2.8.1",
    "uuid": "11.1.0"
  },
  "devDependencies": {
    "@angular/build": "21.2.0",
    "@angular/cli": "21.2.0",
    "@angular/compiler-cli": "21.2.0",
    "@types/jasmine": "5.1.8",
    "@types/lodash": "4.17.20",
    "@playwright/test": "1.58.2",
    "jasmine-core": "5.8.0",
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.1",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.1.0",
    "tailwindcss": "4.1.11",
    "typescript": "5.9.3",
    "@types/node": "24.7.2"
  }
}
