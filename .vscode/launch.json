{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ToBu: API + Stack",
      "type": "node",
      "request": "attach",
      "address": "127.0.0.1",
      "port": 9229,
      "restart": true,
      "preLaunchTask": "ToBu: Debug-Stack",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "sourceMaps": true
    },
    {
      "name": "ToBu: Browser (laufender Stack)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:4200/",
      "webRoot": "${workspaceFolder}/apps/web"
    }
  ]
}
