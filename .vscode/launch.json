{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ToBu: Web",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "ToBu: Web",
      "url": "http://localhost:4200/",
      "webRoot": "${workspaceFolder}/apps/web"
    },
    {
      "name": "ToBu: API (Datenbank separat starten)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/apps/api/src/server.ts",
      "runtimeArgs": [
        "--import",
        "tsx/esm"
      ],
      "cwd": "${workspaceFolder}/apps/api",
      "envFile": "${workspaceFolder}/apps/api/.env",
      "preLaunchTask": "ToBu: API-Konfiguration",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "sourceMaps": true
    }
  ]
}
